# Portal configuration. Copy to .env, fill in, keep it out of git.
#
#   cp .env.example .env && chmod 600 .env
#
# Everything here has a working default except PORTAL_SECRET_KEY, so the
# shortest usable .env is just that one line. install.sh writes this file
# for you; edit it afterwards to change anything.
#
# Syntax note: this file is read both by python-dotenv and by systemd's
# EnvironmentFile=, so it must stay in the intersection of the two --
# no `export`, no shell expansion, no quotes unless they are part of the
# value.


# ---------------------------------------------------------------- required

# Signs the session cookie. Generate one with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
# Changing it logs everyone out. Losing it means you cannot verify any
# existing session, which is the point.
PORTAL_SECRET_KEY=


# ------------------------------------------------------------------- basics

# Shown in the navbar and page titles.
#PORTAL_SITE_NAME=Lustre Tools

# Where generated graphs, the index and the account store live. Must be
# writable by the service user.
#PORTAL_DATA_DIR=/var/lib/portal

# Override individually if they do not belong together.
#PORTAL_GRAPH_DIR=/var/lib/portal/graphs
#PORTAL_USERS_FILE=/var/lib/portal/users.json

# The app binds loopback and expects a reverse proxy in front.
#PORTAL_BIND_HOST=127.0.0.1
#PORTAL_BIND_PORT=5000

# Set to 0 only for plain-HTTP local development: it drops the Secure
# flag from the session cookie.
#PORTAL_COOKIE_SECURE=1

# How long a session stays valid. Accepts a number of hours.
#PORTAL_SESSION_LIFETIME_HOURS=12

# Failed logins allowed per IP before the endpoint starts refusing.
#PORTAL_LOGIN_RATELIMIT=10/minute

# Set when a proxy sits in front, so the app trusts X-Forwarded-For and
# can see real client addresses (needed for rate limiting to mean
# anything). The number is how many proxies are in the chain.
#PORTAL_PROXY_HOPS=1


# ------------------------------------------------------------------- Gerrit

# These deliberately keep their unprefixed names: gerrit-cli and
# gerrit-dashboard read the same variables, so one .env serves all three.
#GERRIT_URL=https://review.whamcloud.com
#JIRA_URL=https://jira.whamcloud.com

# An HTTP password from Gerrit's settings, NOT an account password.
# Leave both blank to query Gerrit anonymously, which is all you need if
# you only ever graph public projects.
#GERRIT_USER=
#GERRIT_PASS=

# The project anyone may graph. Anything else is "internal" and needs an
# account holding the internal role. This one setting defines the whole
# public/private split -- change it deliberately.
#PORTAL_PUBLIC_PROJECT=fs/lustre-release

# Ticket prefix recognised in commit subjects, and the CI accounts whose
# -1 on Verified is worth calling out separately.
#PORTAL_TICKET_PREFIX=LU
#PORTAL_CI_VOTERS=maloo,jenkins


# -------------------------------------------------------- the gc CLI (graphs)

# Resolved on PATH by default, which is right when the portal and the
# tools share a venv. Point at a specific binary to pin one.
#PORTAL_GC_BIN=gc
#PORTAL_GC_CWD=


# ----------------------------------------------------------------- schedules

# Scheduled refreshes land on slots anchored to this time, in this zone.
#PORTAL_TIMEZONE=UTC
#PORTAL_REFRESH_ANCHOR=08:00

# How many graphs may be generated at once, to spread load on Gerrit.
#PORTAL_INTERACTIVE_RUN_CONCURRENCY=3
#PORTAL_SCHEDULED_REFRESH_CONCURRENCY=3


# ------------------------------------------------- optional: a private area

# Unset means the portal has no private area at all. Set a prefix to
# mount a role-gated file listing there. Nothing is shipped in it: point
# PORTAL_PRIVATE_DIR at whatever you want to serve.
#
# The same login also backs /_authcheck?role=<role>, so you can put an
# entirely separate proxied service behind it from your nginx config
# without this app knowing about it.
#PORTAL_PRIVATE_PREFIX=/internal
#PORTAL_PRIVATE_LABEL=Internal
#PORTAL_PRIVATE_ROLE=internal
#PORTAL_PRIVATE_DIR=/var/lib/portal/private
#PORTAL_PRIVATE_THEME=purple


# ------------------------------------- optional: embedded Gerrit dashboard

# Mounts an app-shell at this prefix that keeps the portal header and
# frames a gerrit-dashboard instance proxied at PORTAL_DASHBOARD_APP_PATH.
# Unset means no route and no nav entry.
#PORTAL_DASHBOARD_PREFIX=/gerrit_dash
#PORTAL_DASHBOARD_APP_PATH=/gerrit_dash_app/
