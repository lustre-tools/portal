# nginx site for the Lustre Portal.
#
# Self-contained on purpose: every security header is set here rather
# than inherited from a global http{} block, so a deployment that does
# not have one is still protected. If you DO set these globally, note
# that nginx's add_header does not merge -- a single add_header in a
# location drops every inherited one -- which is why the proxy blocks
# below restate the whole set.
#
# Generated from deploy/nginx-portal.conf.in by install.sh.

# Rate-limit zone for the login endpoint. limit_req_zone is only valid
# at http level -- and a site file is always included from inside
# http{}, so declaring it here works on every distribution's layout.
# 10 MB tracks on the order of 160k client addresses.
#
# The name carries @ZONE_ID@ because zone names are global to the nginx
# instance: two portal sites on one host with the same name is a hard
# [emerg] "already bound to key" and nginx will not start.
limit_req_zone $binary_remote_addr zone=portal_login_@ZONE_ID@:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name @SERVER_NAME@;

    # Leave ACME reachable over plain HTTP so renewals keep working.
    location ^~ /.well-known/acme-challenge/ {
        root @ACME_ROOT@;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @SERVER_NAME@;

    ssl_certificate     @TLS_CERT@;
    ssl_certificate_key @TLS_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    # A zone name of our own: "SSL" is the common default and a host with
    # another site using it at a different size fails nginx -t.
    ssl_session_cache shared:portal_ssl_@ZONE_ID@:10m;
    ssl_session_timeout 1d;

    # Generated graphs embed their own data; a few are large.
    client_max_body_size 4m;

    access_log @LOG_DIR@/portal-access.log;
    error_log  @LOG_DIR@/portal-error.log;

    # --- rate limiting -------------------------------------------------
    location = /login {
        limit_req zone=portal_login_@ZONE_ID@ burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:@PORT@;
        include @SNIPPET_DIR@/portal-proxy.conf;
        include @SNIPPET_DIR@/portal-headers.conf;
    }

    # --- WebSocket ------------------------------------------------------
    location /socket.io/ {
        proxy_pass http://127.0.0.1:@PORT@;
        include @SNIPPET_DIR@/portal-proxy.conf;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # A graph run streams for as long as gc takes.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

@DASHBOARD_BLOCK@
    # --- site-specific locations ------------------------------------
    # Anything this deployment serves that the portal itself does not:
    # a static directory, another proxied service gated on /_authcheck,
    # a redirect you are keeping alive for old links. Drop .conf files
    # in that directory; an empty one is fine and is the default.
    #
    # Kept OUT of the portal's own template so an upgrade never fights
    # your local additions.
    include @SNIPPET_DIR@/site-extra/*.conf;

    # --- the app --------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:@PORT@;
        include @SNIPPET_DIR@/portal-proxy.conf;
        include @SNIPPET_DIR@/portal-headers.conf;
    }
}
